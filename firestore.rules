rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get current user document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Top-level users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Multi-tenant root & subcollections
    match /tenants/{tenantId} {
      allow read: if isAuthenticated() && getUserData().tenantId == tenantId;
      allow write: if isAuthenticated() && getUserData().tenantId == tenantId && getUserData().role in ['admin', 'superAdmin'];

      // Subcollections within tenant: departments, employees, approvalRules, purchaseRequests, etc.
      match /{allChildren=**} {
        allow read: if isAuthenticated() && getUserData().tenantId == tenantId;
        allow write: if isAuthenticated() && getUserData().tenantId == tenantId;
      }
    }
  }
}
